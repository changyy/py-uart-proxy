#!/bin/sh
# Run the tests under every Python CI runs before anything is pushed; a failing
# test stops the push here. Enable once per clone:  git config core.hooksPath .githooks
# Skip in an emergency:   git push --no-verify
cd "$(git rev-parse --show-toplevel)" || exit 1
echo "pre-push: the tests on Python 3.10-3.13 (git push --no-verify skips)" >&2
scripts/test-pythons.sh || { echo "pre-push: tests failed — not pushing" >&2; exit 1; }
